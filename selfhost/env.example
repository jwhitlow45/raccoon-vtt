# The settings and secrets of selfhost/compose.yml. Save this file as .env
# next to compose.yml, make it readable to you alone, and fill it in
# (README.md, "Self-hosting with the published image"):
#
#   chmod 600 .env
#
# GENERATED by scripts/selfhost-compose.ts from docker/server.env.example.
# Nothing in it is a real value. docker compose reads .env for the ${...}
# substitutions in compose.yml. Each container receives only the variables
# compose.yml names, never the whole of .env.
#
# The three marked REQUIRED are enforced by compose itself: it refuses to
# start while any of them is missing or empty.

# REQUIRED. The database password. Postgres reads it only when it initializes
# an empty raccoon-db volume, so changing it later does nothing on its own
# (README.md shows how to rotate it). It also goes into DATABASE_URL, so it
# must be URL safe. This makes one that is:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# REQUIRED. The site's public address: https, the hostname, no path and no
# trailing slash, for example https://vtt.example.com. The WebSocket Origin
# check and the CSRF check compare against it exactly.
PUBLIC_ORIGIN=

# REQUIRED. The key the server keeps each room's player password under, so
# the DM can show the player link and its QR code at any time. 32 random
# bytes in base64. This makes one:
#   openssl rand -base64 32
# Keep it. A new key makes every stored player password unreadable: each DM
# then changes the player password once to get a shareable link again.
ROOM_SECRET_KEY=

# Optional. Enables "search the web" in the image picker. A SerpApi free plan
# key from https://serpapi.com/manage-api-key. It stays on the server and is
# never sent to a browser.
SERPAPI_KEY=

# Optional. Cloudflare Turnstile on the create-room and import forms, and on
# joining a room that has seen 20 wrong passwords in an hour. Set both or
# neither: the secret turns the check on, and the site key is what the forms
# need to show it. The README says how to create the widget.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional. Turns on the admin page at /admin (list rooms, delete rooms,
# storage use). An argon2id hash of a password of 16 or more characters, never
# the password itself. This makes the line to paste here, single-quoted so
# compose leaves its $ signs alone:
#   docker compose run --rm --no-deps raccoon node scripts/admin.ts hash-password
# Unset, there is no admin page. Changing it signs every admin out.
ADMIN_PASSWORD_HASH=

# Optional. An Openverse registration for image search, made once with an
# email address you verify: 40 results a search and a larger daily budget.
# Set both or neither. Unset, Openverse is searched anonymously.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Optional. When the nightly database and image backup runs, as HH:MM in TZ,
# the server's time zone (an IANA name such as America/Chicago). Unset or
# empty means 04:00 UTC.
# BACKUP_AT=04:00
# TZ=UTC

# Optional abuse limits. Unset or empty means the default shown.
# ROOMS_PER_IP_PER_DAY=5
# ROOMS_PER_DAY=20
# ROOM_QUOTA_MB=1024

# Optional. The release to run. Unset, the minor release this compose.yml
# came with, 0.1, which `docker compose pull` moves to its newest patch.
# Pin an exact release, such as 0.1.0, to update only when you change this
# line. A new minor release can come with a new compose.yml: download the
# one at its tag before you move to it.
# RACCOON_VERSION=0.1
# Optional. The image without its tag, for a mirror or a fork.
# RACCOON_IMAGE=docker.io/jwhitlow45/raccoon-vtt

# Optional. Starts Caddy, the HTTPS front end, with every docker compose
# command, so `up`, `pull` and `down` all include it. It needs ports 80
# and 443 open and a DNS record for the host pointing at this server. Leave
# it unset when your own proxy or tunnel serves the site.
# COMPOSE_PROFILES=https
# Optional. What Caddy serves and gets a certificate for. Unset, it is
# PUBLIC_ORIGIN.
# SITE_ADDRESS=https://vtt.example.com

# Optional. 1, the default, takes each visitor's address from the
# CF-Connecting-IP header, which every per-address limit keys on. That is
# right behind Cloudflare and behind the https profile's Caddy, which both
# overwrite the header. Behind a proxy that passes it through, anyone could
# make one up: set 0 there, unless the proxy can overwrite it (README.md,
# "Put HTTPS in front of it").
# TRUST_CF_CONNECTING_IP=1
