// The shell's main and preload, which import Electron, with the logic and
// the contract they use. It needs desktop/node_modules, so only desktop.yml's
// checks job runs it, never the root typecheck (D-261113-087).
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024"],
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["contract.ts", "electron/**/*.ts", "shell/**/*.ts", "vite.shell.config.ts"]
}
