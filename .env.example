# Copy to .env.local for `pnpm dev`. Never commit .env.local.

# Postgres from `pnpm db:up`, on host port 5434 (see docker-compose.yml for
# why not 5432).
DATABASE_URL=postgres://raccoon:raccoon@localhost:5434/raccoon

# Optional. The API server's port, 3000 by default. Vite's proxy follows it.
# PORT=3000

# Where uploaded images are stored in development.
ASSET_DIR=.data/assets

# Optional. Enables "search the web" in the image picker. Server only: it is
# read by the server and never sent to the browser.
# SERPAPI_KEY=

# Optional in development. The key each room's player password is kept under
# for its DM (design 10.2). Unset, a fixed development key is used.
# Production refuses to start without one: openssl rand -base64 32
# ROOM_SECRET_KEY=

# Production only (set in the server's environment, not here):
# On the server they live in .env next to docker-compose.server.yml, made
# from docker/server.env.example (see README.md).
# PUBLIC_ORIGIN=https://vtt.example.com
# TRUST_CF_CONNECTING_IP=1
# EGRESS_STRICT_PROXY=http://egress:3128
# EGRESS_PUBLIC_PROXY=http://egress:3129
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Every other variable in docker/server.env.example works here too, for
# example ADMIN_PASSWORD_HASH to try the admin page. server/config.ts lists
# them all.
