{
  "name": "raccoon-vtt",
  "license": "AGPL-3.0-only",
  "version": "0.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/jwhitlow45/raccoon-vtt.git"
  },
  "bugs": {
    "url": "https://github.com/jwhitlow45/raccoon-vtt/issues"
  },
  "homepage": "https://hub.docker.com/r/jwhitlow45/raccoon-vtt",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*",
    "#server/*": "./server/*"
  },
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:db": "pnpm db:up && pnpm dev",
    "build": "vite build",
    "start": "node server/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test \"shared/**/*.test.ts\" \"server/**/*.test.ts\" \"client/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "test:int": "node --test --test-concurrency=1 \"server/**/*.itest.ts\"",
    "test:e2e": "pnpm build && node scripts/e2e-shard.ts 1 1",
    "test:e2e:shard": "node scripts/e2e-shard.ts",
    "test:backup": "node scripts/backup-check.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U raccoon -d raccoon",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "admin": "node scripts/admin.ts",
    "selfhost": "node scripts/selfhost-compose.ts",
    "readme-button": "node scripts/readme-button.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.5",
    "file-type": "22.1.1",
    "ipaddr.js": "2.5.0",
    "konva": "10.7.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "19.3.0",
    "robust-predicates": "3.0.3",
    "sharp": "0.35.5",
    "undici": "8.11.2",
    "uqr": "0.1.3",
    "ws": "8.22.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.160.0",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "pdfjs-dist": "6.3.289",
    "playwright-core": "1.63.0",
    "three": "0.160.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.23.0"
}
